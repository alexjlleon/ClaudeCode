# Copy this to .env for local dev. On Railway, set these as service variables instead.

PORT=3000

# Comma-separated list of origins allowed to POST tracking events.
# Add every domain the tracker.js snippet will be loaded on.
ALLOWED_ORIGINS=https://weddingsunlimited.com,https://www.weddingsunlimited.com

# Admin dashboard login (basic auth)
ADMIN_USER=alex
ADMIN_PASS=change-me

# Where the SQLite file lives. On Railway, mount a Volume at this path
# so data survives redeploys -- without a volume, the file resets on every deploy.
DB_PATH=./data/traffic.db
